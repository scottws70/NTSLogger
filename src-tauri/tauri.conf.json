{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N8VCL NTS Traffic Logger",
  "version": "1.3.2",
  "identifier": "com.n8vcl.nts-traffic-logger",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "N8VCL NTS Traffic Logger",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDRDg3QzIzN0ExQ0U1MEMKUldRTTVSeDZJM3pZVExIQ0M4NEJrLzZoRUVFeCthOE1DSk5MQkhVY0ZBMTJxSDlrNXl3V3ZpaUwK",
      "endpoints": [
        "https://github.com/scottws70/NTSLogger/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
