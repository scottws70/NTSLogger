{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N8VCL NTS Traffic Logger",
  "version": "1.1.1",
  "identifier": "com.n8vcl.nts-traffic-logger",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "N8VCL NTS Traffic Logger",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
